run = "uvicorn server:app --host 0.0.0.0 --port 8080"
entrypoint = "server.py"
modules = ["python-3.12", "web", "nodejs-20", "nix"]

[env]
PORT = "8080"

[nix]
channel = "stable-25_05"
packages = ["gitFull", "libxcrypt", "playwright-driver"]

[deployment]
run = ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port 8080"]
# Reserved VM, not Autoscale. Autoscale sleeps when no one is browsing, and a
# sleeping process runs no scheduler: no morning digest, no reply polling. This
# app does most of its work with nobody watching, so it has to stay up.
deploymentTarget = "gce"
