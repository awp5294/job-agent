# ── Required ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Random string used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The public URL of this app. Must match the Gmail OAuth redirect URI.
BASE_URL=http://localhost:8000

# ── Gmail OAuth (from Google Cloud Console) ────────────────────────────────
# Needed to send digests, read replies, and sign in with Google.
# Without these the app still works: matches appear on the dashboard, and you
# sign in with the private link shown at the end of onboarding.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────
# SMTP fallback for sending digests when Gmail OAuth isn't connected.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Sign-up requires an invite link (the first account created is exempt).
# Set to 0 only if you want anyone with the URL to be able to sign up.
REQUIRE_INVITE=1

# Which Claude model scores jobs and writes cover letters.
ANTHROPIC_MODEL=claude-opus-5

# When the daily digest runs, and in which timezone.
DIGEST_HOUR=8
TIMEZONE=UTC

# Where the SQLite file lives.
DB_PATH=jobagent.db
