# ── Required: one AI key (either provider works) ───────────────────────────
# Set whichever you have. If both are set, Claude is used unless you set
# LLM_PROVIDER=gemini.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Random string used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The public URL of this app (used for invite links).
BASE_URL=http://localhost:8000

# ── Email: one mailbox for the whole app ───────────────────────────────────
# The app sends every digest from this address and reads replies from its inbox.
# Users just tell the app where to send their digest — they never connect an
# account of their own.
#
# For Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste it as SMTP_PASS.
# No Google Cloud project, no OAuth consent screen.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Reading replies. Defaults suit Gmail; only set these for another provider.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Optional: show a different From address than the mailbox login.
MAIL_FROM=

# ── Optional ───────────────────────────────────────────────────────────────
# Sign-up requires an invite link (the first account created is exempt).
# Set to 0 only if you want anyone with the URL to be able to sign up.
REQUIRE_INVITE=1

# Force a provider when both keys are present: anthropic | gemini
LLM_PROVIDER=

# Which model scores jobs and writes cover letters. Defaults:
#   claude-opus-5 (Anthropic) / gemini-2.5-flash (Gemini)
ANTHROPIC_MODEL=
GEMINI_MODEL=

# When the daily digest runs, and in which timezone.
DIGEST_HOUR=8
TIMEZONE=UTC

# How many jobs go in one digest email.
DIGEST_LIMIT=10

# How often to check for replies to a digest (minutes).
REPLY_POLL_MINUTES=15

# Where the SQLite file lives.
DB_PATH=jobagent.db
